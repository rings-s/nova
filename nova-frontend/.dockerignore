# Keep the build context small and the image clean. Anything listed here is
# invisible to `COPY . .` in the runtime stage.

# The dev stage bind-mounts the real tree and installs its own node_modules
# into a named volume; a host tree copied in would be both wrong (platform-
# specific native binaries) and enormous.
node_modules
.svelte-kit
build
.wrangler

.env
.env.*
!.env.example

.git/
.gitignore
.github/

# Editor and OS noise.
.idea/
.vscode/
.DS_Store

test-results/
playwright-report/

# Not needed to run the service. The dev target bind-mounts the real tree over
# /app, so excluding them costs a developer nothing.
README.md
