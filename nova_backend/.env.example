ENV=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5432/nova
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-to-a-random-value

# Authentication. Bearer tokens are HS256 JWTs verified with SECRET_KEY.
# AUTH_DEV_BYPASS treats every caller as a trusted service principal and is
# REFUSED unless ENV is local or test — never set it in a deployed environment.
AUTH_DEV_BYPASS=true

# Connection pool and query safety
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=10000

CORS_ORIGINS=["http://localhost:5173"]

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","ar"]
DEFAULT_TIMEZONE=Asia/Riyadh
DEFAULT_CURRENCY=SAR
ALLOWED_PHONE_COUNTRY_CODES=["966","971","973","974","965","968"]

# --- Reserved for future integration adapters. Leave unset until implemented. ---
# WHATSAPP_BSP_API_KEY=
# MOYASAR_API_KEY=
# NEXTCLOUD_URL=
# NEXTCLOUD_USERNAME=
# NEXTCLOUD_APP_PASSWORD=
# CLOUDFLARE_TUNNEL_TOKEN=
