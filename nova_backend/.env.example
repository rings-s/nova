# Read as nova_backend/.env when the app runs from this directory, against
# postgres and redis on localhost. The compose stack reads infra/.env instead.

ENV=local
DEBUG=true

DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5432/nova
# The compose redis requires REDIS_PASSWORD from infra/.env:
#   REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
REDIS_URL=redis://localhost:6379/0
# Required, and never committed. Generate one: openssl rand -hex 32
SECRET_KEY=

# Authentication. Bearer tokens are HS256 JWTs verified with SECRET_KEY.
# AUTH_DEV_BYPASS treats a request with no token as a trusted service principal.
# The app refuses to start with it unless ENV is local or test, and whenever
# CLOUDFLARE_TUNNEL_TOKEN is set. Turn it on for local work only.
AUTH_DEV_BYPASS=false

# /docs, /redoc and /openapi.json. Unset: served only when ENV is local or test.
# API_DOCS_ENABLED=

# Connection pool and query safety
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=10000

CORS_ORIGINS=["http://localhost:5173"]

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","ar"]
DEFAULT_TIMEZONE=Asia/Riyadh
DEFAULT_CURRENCY=SAR
ALLOWED_PHONE_COUNTRY_CODES=["966","971","973","974","965","968"]

# --- Reserved for future integration adapters. Leave unset until implemented. ---
# WHATSAPP_BSP_API_KEY=
# MOYASAR_API_KEY=
# CLOUDFLARE_TUNNEL_TOKEN=
