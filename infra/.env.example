# Copy to infra/.env before running `docker compose up`.

# --- Postgres ---
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova
POSTGRES_DB=nova
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-value

# --- Frontend ---
FRONTEND_PORT=5173
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Reserved for future integration adapters. Leave unset until implemented. ---
# WHATSAPP_BSP_API_KEY=
# MOYASAR_API_KEY=
# NEXTCLOUD_URL=
# NEXTCLOUD_USERNAME=
# NEXTCLOUD_APP_PASSWORD=
