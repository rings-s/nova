# `make dev` creates infra/.env from this file and fills every blank secret
# below with a fresh random value (`make infra/.env` does only that step). To
# do it by hand, copy the file and set each blank secret to the output of
# `openssl rand -hex 32`.
#
# infra/.env is git-ignored. Never put a real credential in this file: the
# repository is public, so anything committed here is published.

# --- Container identity ---
# The backend container bind-mounts the source tree and writes into it
# (`alembic revision --autogenerate`), so its uid must match yours. Change
# these if `id -u` / `id -g` are not 1000, then rebuild: `make dev`.
UID=1000
GID=1000

# --- Datastores (compose service names resolve inside the network) ---
POSTGRES_USER=nova
# The schema owner, a superuser. Compose gives it to the `migrate` and `tools`
# containers only, never to `backend` or `worker`.
POSTGRES_PASSWORD=
POSTGRES_DB=nova
# The login for `nova_app`, the role the API and worker connect as, because
# Postgres exempts a superuser from row-level security. Goes into a URL, so
# keep it URL-safe: openssl rand -hex 32
POSTGRES_APP_PASSWORD=
# Created on first volume initialisation by infra/postgres/initdb. `make test`
# runs against this, never against POSTGRES_DB.
POSTGRES_TEST_DB=nova_test
# Redis refuses clients without it. ARQ keeps its job queue there, and a queued
# job is something the worker runs. Goes into a URL, so keep it URL-safe.
REDIS_PASSWORD=
# Published on 127.0.0.1 only.
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Application ---
ENV=local
DEBUG=true
# Signs every token, slot id, QR ticket and photo preview link. The app
# refuses an empty key, and outside ENV=local/test one under 32 characters.
SECRET_KEY=

# true turns a request with no token into a service principal that reaches
# every tenant. For local work only: the app refuses to start with it unless
# ENV is local or test, and whenever CLOUDFLARE_TUNNEL_TOKEN is set.
AUTH_DEV_BYPASS=false

CORS_ORIGINS=["http://localhost:5173"]
# The customer app. A payment's return_url must be on this origin.
# PUBLIC_APP_URL=http://localhost:5173
# /docs, /redoc and /openapi.json. Unset: served only when ENV is local or test.
# API_DOCS_ENABLED=

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","ar"]
DEFAULT_TIMEZONE=Asia/Riyadh
DEFAULT_CURRENCY=SAR

# --- Ingress (optional) ---
# Set this and run `make tunnel` to expose the stack through Cloudflare with no
# open inbound ports. Leave blank for local-only development.
CLOUDFLARE_TUNNEL_TOKEN=
# The header your proxy writes with the real client address, for IP rate
# limits. Unset: the TCP peer, or CF-Connecting-IP while the tunnel token is
# set. Never X-Forwarded-For, whose first entry the client writes. Required
# (or the tunnel token) when ENV is not local or test: the app refuses to start.
# CLIENT_IP_HEADER=

# --- Integrations (leave unset until credentials exist; adapters raise
#     IntegrationNotConfiguredError and the app still boots) ---
# MOYASAR_SECRET_KEY_ID=   (the secret key, sk_test_… / sk_live_…; MOYASAR_API_KEY also works)
# MOYASAR_WEBHOOK_SECRET=
# The publishable key (pk_test_/pk_live_, same mode as MOYASAR_API_KEY). Set, the
# customer pays in Moyasar's Payment Form on NOVA's page; unset, on Moyasar's
# hosted invoice page.
# MOYASAR_PUBLISHABLE_KEY=
# WHATSAPP_BSP_API_KEY=
# WHATSAPP_BSP_BASE_URL=
# WHATSAPP_PHONE_NUMBER_ID=

# --- AI agents (optional) ---
# Without a model server, agents hand off to a human and every other flow
# works. Setup, model choice and timings: nova_backend/README.md, "AI agents
# (local models)". Recreate backend and worker after changing these.
#
# The models come from vLLM, the compose `llm` service (ADR-0019), which starts
# with the stack. The first start downloads the weights into the `llm_models`
# volume. The base file runs vLLM's CPU build (it needs AVX-512); on a GPU,
# layer the CUDA build over it:
#   docker compose -f infra/docker-compose.yml -f infra/docker-compose.gpu.yml \
#     --env-file infra/.env --profile tts up -d
AI_PROVIDER=vllm
AI_BASE_URL=http://llm:8000/v1
AI_ROUTING_MODEL=qwen3-4b
AI_REASONING_MODEL=qwen3-4b
AI_THINKING=false
# A grounded staff turn is 3-4 model calls: minutes on a CPU. Lower it on a GPU.
AI_REQUEST_TIMEOUT_SECONDS=600
# The `llm` service's own knobs (defaults shown). LLM_MODEL is a Hugging Face
# repo; LLM_ALIAS is the model name above, and must contain "qwen3" for
# thinking to be switched off. Raise LLM_PARALLEL together with
# AI_MAX_CONCURRENT_TURNS.
# LLM_MODEL=Qwen/Qwen3-4B
# LLM_ALIAS=qwen3-4b
# LLM_CTX=8192
# LLM_PARALLEL=1
# LLM_CPU_KVCACHE_GIB=2
# Without a GPU: vLLM loads full-precision weights, about 8 GB for the 4B, so
# serve the 1.7B (about 3.4 GB) and set both AI_*_MODEL to qwen3-1.7b:
# LLM_MODEL=Qwen/Qwen3-1.7B
# LLM_ALIAS=qwen3-1.7b

# Sara, the phone agent (ADR-0017; nova_backend/README.md, "Sara on the phone").
# A faster llama-server for voice turns (unset values fall back to AI_*, the `llm`
# service), the API's public origin for Unifonic's webhooks, and the key for
# reminder calls. llama.cpp is the only model server.
# VOICE_AI_BASE_URL=
# VOICE_AI_MODEL=
# VOICE_AI_API_KEY=
# VOICE_PUBLIC_BASE_URL=
# UNIFONIC_VOICE_API_KEY=
# Sara's own Saudi voice: the compose `tts` service (infra/tts, ADR-0018),
# serving the Qwen3-TTS fine-tune vadimbelsky/qwen3-TTS-KSA on a GPU. Unset,
# Unifonic's text-to-speech reads her replies. VOICE_TTS_API_KEY, when set, is
# also the key the `tts` service requires.
# VOICE_TTS_BASE_URL=http://tts:8091/v1
# VOICE_TTS_MODEL=vadimbelsky/qwen3-TTS-KSA
# VOICE_TTS_VOICE=ksa_speaker
# VOICE_TTS_API_KEY=
# A CPU-only build of the `tts` image (development; too slow for a call):
# TTS_TORCH_INDEX=https://download.pytorch.org/whl/cpu

# Business photos are stored under MEDIA_ROOT, which compose sets to
# /app/.media (inside the bind-mounted source tree) for local development.

# GET /metrics (Prometheus text: request counts and latency, outbox backlog and
# dead letters) needs `Authorization: Bearer <this>`. Unset, the route is a 404.
# Generate one: openssl rand -hex 24
# METRICS_TOKEN=

# Scheduled backups (`docker compose --profile backup up -d backup`): how many
# dumps to keep, and the seconds between them. infra/backup/README.md.
# BACKUP_KEEP=14
# BACKUP_INTERVAL_SECONDS=86400
