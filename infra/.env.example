# Copy to infra/.env before running `make dev`.
#
#   cp infra/.env.example infra/.env
#
# infra/.env is git-ignored. Never commit real credentials.

# --- Container identity ---
# The backend container bind-mounts the source tree and writes into it
# (`alembic revision --autogenerate`), so its uid must match yours. Change
# these if `id -u` / `id -g` are not 1000, then rebuild: `make dev`.
UID=1000
GID=1000

# --- Datastores (compose service names resolve inside the network) ---
POSTGRES_USER=nova
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=nova
# The login for `nova_app`, the role the API and worker connect as. Postgres
# exempts POSTGRES_USER, a superuser, from row-level security, so only the
# migrate job uses it. Goes into a URL, so keep it URL-safe: openssl rand -hex 24
POSTGRES_APP_PASSWORD=change-me-app-password
# Created on first volume initialisation by infra/postgres/initdb. `make test`
# runs against this, never against POSTGRES_DB.
POSTGRES_TEST_DB=nova_test
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000

# --- Application ---
ENV=local
DEBUG=true
# Generate a real one: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-value

# Treats every caller as a trusted service principal. `app/core/security.py`
# REFUSES to honour this unless ENV is local or test.
AUTH_DEV_BYPASS=true

CORS_ORIGINS=["http://localhost:5173"]

DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en","ar"]
DEFAULT_TIMEZONE=Asia/Riyadh
DEFAULT_CURRENCY=SAR

# --- Ingress (optional) ---
# Set this and run `make tunnel` to expose the stack through Cloudflare with no
# open inbound ports. Leave blank for local-only development.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Integrations (leave unset until credentials exist; adapters raise
#     IntegrationNotConfiguredError and the app still boots) ---
# MOYASAR_API_KEY=
# MOYASAR_WEBHOOK_SECRET=
# NEXTCLOUD_URL=
# NEXTCLOUD_USERNAME=
# NEXTCLOUD_APP_PASSWORD=
# WHATSAPP_BSP_API_KEY=
# WHATSAPP_BSP_BASE_URL=
# WHATSAPP_PHONE_NUMBER_ID=
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
